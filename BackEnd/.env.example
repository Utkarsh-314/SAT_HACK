# Copy this file to BackEnd/.env and fill in real values. Never commit .env.

# MySQL connection (SQLAlchemy URL), e.g. mysql+pymysql://user:password@localhost:3306/signconnect
DATABASE_URL=

# Long random string used to sign login tokens
SECRET_KEY=

# Groq speech-to-text: your own key from https://console.groq.com/keys (starts with gsk_)
GROQ_API_KEY=

# Optional: whisper-large-v3-turbo (faster, default) or whisper-large-v3 (more accurate)
GROQ_STT_MODEL=whisper-large-v3-turbo
